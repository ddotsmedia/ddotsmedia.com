# ─── Database (PostgreSQL — Payload CMS) ───
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/ddotsmedia

# ─── Payload CMS ───
PAYLOAD_SECRET=replace-with-a-long-random-string

# ─── Email: SMTP (fallback) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ddotsmedia <noreply@ddotsmedia.com>"

# ─── Email: Resend (preferred) ───
RESEND_API_KEY=
RESEND_FROM="Ddotsmedia <noreply@ddotsmedia.com>"
# Where contact-form submissions are emailed. If RESEND_API_KEY is unset, the
# /api/contact route logs the submission and still returns success (dev fallback).
ADMIN_EMAIL=hello@ddotsmedia.com

# ─── Screenshots: ApiFlash (auto-capture project covers) ───
# When a Project's liveUrl is saved, the Projects beforeChange hook captures a
# screenshot via ApiFlash. If unset, capture is skipped gracefully (save still ok).
APIFLASH_ACCESS_KEY=

# ─── Site ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
